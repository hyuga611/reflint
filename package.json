{
  "name": "@hyuga/reflint",
  "version": "0.8.0",
  "description": "Reference-integrity linter for AGENTS.md / llms.txt / CLAUDE.md — fail CI when agent config points at commands, scripts, or paths that no longer exist. Language-agnostic, zero-dependency.",
  "type": "module",
  "main": "src/check.mjs",
  "exports": {
    ".": "./src/check.mjs",
    "./textlint-rule": "./src/textlint-rule.mjs"
  },
  "bin": {
    "reflint": "src/check.mjs"
  },
  "files": [
    "src",
    "action.yml"
  ],
  "scripts": {
    "poc": "node src/check.mjs examples/AGENTS.sample.md",
    "test": "node --test"
  },
  "keywords": [
    "agents.md",
    "llms.txt",
    "claude.md",
    "ai",
    "agent",
    "linter",
    "ci",
    "reference-integrity",
    "language-agnostic",
    "mcp"
  ],
  "license": "MIT",
  "author": "hyuga611",
  "homepage": "https://github.com/hyuga611/reflint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyuga611/reflint.git"
  },
  "bugs": {
    "url": "https://github.com/hyuga611/reflint/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
